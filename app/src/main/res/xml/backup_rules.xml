<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: nothing is backed up. The database holds card details and the sync token;
     use Server sync or Settings > Export to move data to a new phone. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
