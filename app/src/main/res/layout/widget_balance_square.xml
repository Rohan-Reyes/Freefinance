<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_logo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="Liquid funds"
            android:textColor="#B3C7CF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_accounts_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#8FA6AF"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_total_balance"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="28sp"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="₱0.00"
        android:textColor="#FFFFFF"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/tv_sub_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:maxLines="1"
        android:text="All accounts"
        android:textColor="#8FA6AF"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_quick_pic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:drawableStart="@drawable/ic_w_camera"
            android:drawablePadding="4dp"
            android:drawableTint="#D6E4E9"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="Scan"
            android:textColor="#D6E4E9"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_quick_add"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_accent_bg"
            android:drawableStart="@drawable/ic_w_add"
            android:drawablePadding="4dp"
            android:drawableTint="#0B1F1A"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="Add"
            android:textColor="#0B1F1A"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
